<Window
    x:Class="ForecastCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ForecastCenter"
    xmlns:vm="using:ForecastCenter.ViewModels"
    xmlns:models="using:ForecastCenter.Models">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions><RowDefinition x:Name="TitleBarRow" Height="48"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Grid.RowSpan="2" Background="{ThemeResource DashboardBaseColor}"/>
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0.1,0.85">
                    <GradientStop Color="{x:Bind ViewModel.DashboardGlowColor, Mode=OneWay}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.72"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Height="48" Padding="12,0,150,0" Background="Transparent"/>
        <Grid Grid.Row="1">
            <Grid>
                <ScrollViewer x:Name="WeatherPage" HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DashboardGrid" Padding="28,18,28,36" HorizontalAlignment="Stretch" SizeChanged="DashboardGrid_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.LocationName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Updated, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="9" Click="OpenSettings_Click" ToolTipService.ToolTip="Settings"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16"/></Button>
                                <ComboBox x:Name="SavedLocationPicker" Width="260" Height="40" PlaceholderText="Choose location" SelectionChanged="SavedLocationPicker_SelectionChanged"/>
                                <Button x:Name="DefaultLocationButton" Height="40" Padding="14,0" Click="SetDefaultLocation_Click" ToolTipService.ToolTip="Use this location when Forecast Center starts"><TextBlock Text="Make default"/></Button>
                            </StackPanel>
                        </Grid>
                        <InfoBar Grid.Row="1" Margin="0,12,0,0" CornerRadius="12" IsOpen="{x:Bind ViewModel.StatusVisible, Mode=OneWay}" Severity="Warning" Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
                        <InfoBar Grid.Row="2" Margin="0,12,0,0" CornerRadius="12" IsOpen="{x:Bind ViewModel.HasAlerts, Mode=OneWay}" Severity="Error" Title="Active weather alert" Message="{x:Bind ViewModel.AlertHeadline, Mode=OneWay}" Tapped="OpenAlerts_Tapped" ToolTipService.ToolTip="Open active alerts"><InfoBar.ActionButton><Button Content="View details" Click="OpenAlerts_Click"/></InfoBar.ActionButton></InfoBar>
                        <Grid x:Name="CommandCenterGrid" Grid.Row="5" Margin="0,16,0,0" ColumnSpacing="10" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CommandColumn1"/><ColumnDefinition x:Name="CommandColumn2"/><ColumnDefinition x:Name="CommandColumn3"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="NearTermCard" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16" Background="#102A8EDB" BorderBrush="#282A8EDB"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE823;" FontSize="20" Foreground="#4AADE8" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="NEXT 12 HOURS" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.NearTermSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                            <Border x:Name="TemperatureTrendCard" Grid.Column="1" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16" Visibility="{x:Bind ViewModel.TemperatureTrendVisibility, Mode=OneWay}" Background="#109B8BEA" BorderBrush="#289B8BEA"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#A99AF0" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="TEMPERATURE TREND" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.TemperatureTrend, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                            <Border x:Name="NextHourCard" Grid.Column="1" Style="{StaticResource WeatherCardStyle}" Height="116" Padding="14" Visibility="{x:Bind ViewModel.NextHourVisibility, Mode=OneWay}" Background="#102A8EDB" BorderBrush="#282A8EDB">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/metrics/precipitation.svg" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="NEXT HOUR" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.NextHourSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <ItemsRepeater Grid.Column="2" ItemsSource="{x:Bind ViewModel.NextHourPrecipitation}" VerticalAlignment="Center"><ItemsRepeater.Layout><UniformGridLayout Orientation="Horizontal" MinItemWidth="28" MinColumnSpacing="2" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:NextHourPrecipitationItem"><Grid RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Border Width="14" Height="42" CornerRadius="5" Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"/><Rectangle Width="14" Height="{x:Bind CompactBarHeight}" RadiusX="5" RadiusY="5" VerticalAlignment="Bottom" HorizontalAlignment="Center"><Rectangle.Fill><SolidColorBrush Color="{x:Bind Color}"/></Rectangle.Fill></Rectangle></Grid><TextBlock Grid.Row="1" Text="{x:Bind Probability}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Grid.Row="2" Text="{x:Bind Time}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/></Grid></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
                                </Grid>
                            </Border>
                            <Border x:Name="DaylightCard" Grid.Column="2" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16" Background="#12F2B84B" BorderBrush="#2AF2B84B"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE706;" FontSize="20" Foreground="#F2B84B" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="DAYLIGHT" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.DaylightStatus, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                            <Border x:Name="ComfortCard" Grid.Column="3" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16"><Border.Background><SolidColorBrush Color="{x:Bind ViewModel.ComfortTintColor, Mode=OneWay}"/></Border.Background><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9CA;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon.Foreground><SolidColorBrush Color="{x:Bind ViewModel.ComfortAccentColor, Mode=OneWay}"/></FontIcon.Foreground></FontIcon><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="OUTDOOR COMFORT" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.ComfortSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/><local:RiskScale Kind="Comfort" Value="{x:Bind ViewModel.ComfortScaleValue, Mode=OneWay}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                            <Border x:Name="UvCard" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16"><Border.Background><SolidColorBrush Color="{x:Bind ViewModel.UvTintColor, Mode=OneWay}"/></Border.Background><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/metrics/uv.svg" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="UV INDEX" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.UvSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/><local:RiskScale Kind="Uv" Value="{x:Bind ViewModel.UvScaleValue, Mode=OneWay}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                            <Border x:Name="AirQualityCard" Style="{StaticResource WeatherCardStyle}" MinHeight="78" Padding="16"><Border.Background><SolidColorBrush Color="{x:Bind ViewModel.AirQualityTintColor, Mode=OneWay}"/></Border.Background><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/metrics/air-quality.svg" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="AIR QUALITY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.AirQualitySummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/><local:RiskScale Kind="Aqi" Value="{x:Bind ViewModel.AirQualityScaleValue, Mode=OneWay}" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                        </Grid>
                        <Grid x:Name="HeroGrid" Grid.Row="3" Margin="0,16,0,0" ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeroPrimaryColumn" Width="1.1*"/><ColumnDefinition x:Name="HeroSecondaryColumn" Width="1*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="HeroSecondRow" Height="0"/></Grid.RowDefinitions>
                            <Border x:Name="CurrentWeatherCard" Style="{StaticResource WeatherCardStyle}" Height="450" Padding="0" BorderBrush="{ThemeResource HeroCardStrokeBrush}" PointerEntered="CurrentWeatherCard_PointerEntered" PointerExited="CurrentWeatherCard_PointerExited">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{x:Bind ViewModel.HeroStartColor, Mode=OneWay}" Offset="0"/>
                                        <GradientStop Color="{x:Bind ViewModel.HeroEndColor, Mode=OneWay}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Padding="20" Background="{ThemeResource HeroToneOverlayBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CURRENT WEATHER" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80" Foreground="#C9E5FF" />
                                        <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}" FontSize="72" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" />
                                        <TextBlock Text="{x:Bind ViewModel.Condition, Mode=OneWay}" FontSize="24" Foreground="White" />
                                        <TextBlock Text="{x:Bind ViewModel.FeelsLike, Mode=OneWay}" Margin="0,10,0,0" Foreground="#D5E9FA" />
                                        <TextBlock Text="{x:Bind ViewModel.HighLow, Mode=OneWay}" Margin="0,4,0,0" Foreground="White" />
                                        <TextBlock Text="{x:Bind ViewModel.ForecastSummary, Mode=OneWay}" Margin="0,14,24,0" MaxWidth="520" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="#E8F4FF" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center">
                                        <Ellipse Fill="#18FFFFFF"/>
                                        <Ellipse Width="112" Height="112" Fill="#14FFFFFF"/>
                                        <TextBlock Text="{x:Bind ViewModel.ConditionGlyph, Mode=OneWay}" FontSize="88" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button x:Name="HeroRefreshButton" Grid.Column="1" Canvas.ZIndex="3" Width="36" Height="36" Padding="0" Margin="0,-8,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" Click="Refresh_Click" Background="#28000000" BorderThickness="0" CornerRadius="18" Foreground="White" ToolTipService.ToolTip="Refresh weather"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                        <local:MetricItem Grid.Row="1" IconSource="ms-appx:///Assets/metrics/humidity.svg" Label="Humidity" Value="{x:Bind ViewModel.Humidity, Mode=OneWay}"/>
                                        <local:MetricItem Grid.Row="1" Grid.Column="1" IconSource="ms-appx:///Assets/metrics/dewpoint.svg" Label="Dew point" Value="{x:Bind ViewModel.DewPoint, Mode=OneWay}"/>
                                        <local:MetricItem Grid.Row="1" Grid.Column="2" IconSource="ms-appx:///Assets/metrics/wind.svg" Label="Wind" Value="{x:Bind ViewModel.Wind, Mode=OneWay}"/>
                                        <local:MetricItem Grid.Row="3" IconSource="ms-appx:///Assets/metrics/visibility.svg" Label="Visibility" Value="{x:Bind ViewModel.Visibility, Mode=OneWay}"/>
                                        <local:MetricItem Grid.Row="3" Grid.Column="1" IconSource="ms-appx:///Assets/metrics/pressure.svg" Label="Pressure" Value="{x:Bind ViewModel.Pressure, Mode=OneWay}"/>
                                        <local:MetricItem Grid.Row="3" Grid.Column="2" IconSource="ms-appx:///Assets/metrics/sunrise.svg" Label="Sunrise / sunset" Value="{x:Bind ViewModel.SunTimes, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid x:Name="DashboardRadarSection" Grid.Column="1" Height="450">
                                <Border x:Name="DashboardRadarCard" Height="450" Style="{StaticResource WeatherCardStyle}" Padding="0" BorderBrush="{ThemeResource HeroCardStrokeBrush}">
                                    <Grid>
                                        <WebView2 x:Name="DashboardRadarWebView"/>
                                        <Grid x:Name="DashboardRadarLoading" Canvas.ZIndex="10" IsHitTestVisible="False">
                                            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182A8EDB"/><GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0.65"/></LinearGradientBrush></Grid.Background>
                                            <Rectangle x:Name="RadarLoadingShimmer" Width="230" HorizontalAlignment="Left" Opacity="0.5"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#22FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Grid Width="62" Height="62"><Ellipse Fill="#142A8EDB" Stroke="#354AADE8" StrokeThickness="1"/><Ellipse Width="42" Height="42" Fill="#182A8EDB"/><FontIcon Glyph="&#xE707;" FontSize="22" Foreground="#62D7F2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock x:Name="RadarLoadingTitle" Text="Initializing live radar" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="RadarLoadingSubtitle" Text="Loading map and latest weather frames" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel>
                                        </Grid>
                                        <Border x:Name="DashboardRadarAttribution" Canvas.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="5,2" CornerRadius="4" Background="#A8202730" Opacity="0.78"><TextBlock Text="NOAA/NWS · © OSM/OpenMapTiles/OpenFreeMap · GeoNames" FontSize="8" Foreground="White"/></Border>
                                        <Border x:Name="DashboardRadarExpandHint" Canvas.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="11,7" CornerRadius="9" Background="#D0202730" BorderBrush="#28FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="13" Foreground="White"/><TextBlock Text="Click map to expand" FontSize="12" FontWeight="SemiBold" Foreground="White"/></StackPanel></Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Row="6" Margin="0,24,0,0" Spacing="10">
                            <TextBlock Text="Hourly forecast" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid>
                                <ScrollViewer x:Name="HourlyScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" PointerWheelChanged="ForecastScroller_PointerWheelChanged" Loaded="ForecastScroller_Loaded" ViewChanged="ForecastScroller_ViewChanged">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Hours}"><ItemsRepeater.Layout><UniformGridLayout x:Name="HourlyLayout" Orientation="Horizontal" MinItemWidth="80" MinItemHeight="142" MinColumnSpacing="8" ItemsJustification="Start" ItemsStretch="Fill"/></ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:HourlyItem"><Border Tag="{x:Bind Timestamp}" Style="{StaticResource WeatherCardStyle}" MinWidth="80" Padding="10" PointerEntered="HourlyForecastCard_PointerEntered" PointerExited="HourlyForecastCard_PointerExited"><Border.Background><SolidColorBrush Color="{x:Bind TintColor}"/></Border.Background><StackPanel HorizontalAlignment="Center" Spacing="7"><TextBlock Text="{x:Bind Time}"/><TextBlock Text="{x:Bind Glyph}" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind Temperature}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind Precipitation}" Foreground="#4AADE8" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <Button x:Name="HourlyLeftButton" Canvas.ZIndex="2" Width="38" Height="142" Padding="0" CornerRadius="12,0,0,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Tag="hourly-left" Click="ForecastScroll_Click" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Earlier hours"><FontIcon Glyph="&#xE76B;" FontSize="13"/></Button>
                                <Button x:Name="HourlyRightButton" Canvas.ZIndex="2" Width="38" Height="142" Padding="0" CornerRadius="0,12,12,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Tag="hourly-right" Click="ForecastScroll_Click" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Later hours"><FontIcon Glyph="&#xE76C;" FontSize="13"/></Button>
                            </Grid>
                            <Border x:Name="HourlyTrendCard" Style="{StaticResource WeatherCardStyle}" Padding="16,12" HorizontalAlignment="Left">
                                <Grid RowSpacing="7">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image Source="ms-appx:///Assets/metrics/dewpoint.svg" Width="17" Height="17" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="DEW POINT &amp; PRECIPITATION" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HourlyTrendRangeText" Grid.Column="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <local:HourlyTrendChart x:Name="HourlySignalChart" Grid.Row="1" Items="{x:Bind ViewModel.HourlyTrend, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Margin="0,24,0,0" Spacing="10">
                            <TextBlock Text="10-day forecast" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid>
                                <ScrollViewer x:Name="DailyScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" PointerWheelChanged="ForecastScroller_PointerWheelChanged" Loaded="ForecastScroller_Loaded" ViewChanged="ForecastScroller_ViewChanged">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Days}"><ItemsRepeater.Layout><UniformGridLayout x:Name="DailyLayout" Orientation="Horizontal" MinItemWidth="100" MinItemHeight="168" MinColumnSpacing="8" ItemsJustification="Start" ItemsStretch="Fill"/></ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:DailyItem"><Button Tag="{x:Bind FullDate}" MinWidth="100" MinHeight="168" Padding="10" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="DailyForecast_Click" PointerEntered="DailyForecastCard_PointerEntered" PointerExited="DailyForecastCard_PointerExited"><Button.Background><SolidColorBrush Color="{x:Bind TintColor}"/></Button.Background><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7"><TextBlock Text="{x:Bind Day}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind Glyph}" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind Condition}" MaxLines="1" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><TextBlock Text="{x:Bind High}" FontSize="18" FontWeight="SemiBold" Foreground="#EF8B70"/><TextBlock Text="{x:Bind Low}" FontSize="18" Foreground="#70AEEF"/></StackPanel><TextBlock Text="{x:Bind Precipitation}" Foreground="#4AADE8" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                                <Button x:Name="DailyLeftButton" Canvas.ZIndex="2" Width="38" Height="168" Padding="0" CornerRadius="12,0,0,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Tag="daily-left" Click="ForecastScroll_Click" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Previous days"><FontIcon Glyph="&#xE76B;" FontSize="13"/></Button>
                                <Button x:Name="DailyRightButton" Canvas.ZIndex="2" Width="38" Height="168" Padding="0" CornerRadius="0,12,12,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Tag="daily-right" Click="ForecastScroll_Click" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Next days"><FontIcon Glyph="&#xE76C;" FontSize="13"/></Button>
                            </Grid>
                        </StackPanel>
                        <Grid x:Name="BottomFeaturesGrid" Grid.Row="8" Margin="0,24,0,0" ColumnSpacing="16" RowSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="BottomFeatureColumn1" Width="1.35*"/><ColumnDefinition x:Name="BottomFeatureColumn2" Width="0.65*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <!-- The dashboard radar now lives in the hero area.
                        <StackPanel x:Name="DashboardRadarSection" Spacing="10">
                            <TextBlock Text="Radar" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                            <Border x:Name="DashboardRadarCard" Height="340" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundBrush}"><Grid><WebView2 x:Name="DashboardRadarWebView"/><Grid x:Name="DashboardRadarLoading" Canvas.ZIndex="10" IsHitTestVisible="False"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182A8EDB"/><GradientStop Color="{ThemeResource CardBackgroundFillColorDefault}" Offset="0.65"/></LinearGradientBrush></Grid.Background><Rectangle x:Name="RadarLoadingShimmer" Width="230" HorizontalAlignment="Left" Opacity="0.5"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#22FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Grid Width="62" Height="62"><Ellipse Fill="#142A8EDB" Stroke="#354AADE8" StrokeThickness="1"/><Ellipse Width="42" Height="42" Fill="#182A8EDB"/><FontIcon Glyph="&#xE707;" FontSize="22" Foreground="#62D7F2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock x:Name="DashboardRadarLoadingTitle" Text="Initializing live radar" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardRadarLoadingSubtitle" Text="Loading map and latest weather frames" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel></Grid></Grid></Border>
