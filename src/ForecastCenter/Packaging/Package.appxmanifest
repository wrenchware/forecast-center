<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest. Only used by Store builds:
    dotnet publish ... -p:StoreBuild=true   (see docs/microsoft-store.md)

  Before the first Store submission, replace the three PARTNER-CENTER values below
  with the ones shown in Partner Center > your app > Product identity:
    Identity Name, Identity Publisher, and PublisherDisplayName.
  The Store rejects a package whose identity does not match exactly.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity
    Name="PARTNER-CENTER.PackageIdentityName"
    Publisher="CN=PARTNER-CENTER-PUBLISHER-ID"
    Version="1.0.3.0" />

  <Properties>
    <DisplayName>Forecast Center</DisplayName>
    <PublisherDisplayName>PARTNER-CENTER-PUBLISHER-DISPLAY-NAME</PublisherDisplayName>
    <Logo>Packaging\Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Forecast Center"
        Description="A fast, ad-free Windows weather dashboard with radar, hourly and 10-day forecasts, alerts, tides, and air quality."
        BackgroundColor="transparent"
        Square150x150Logo="Packaging\Images\Square150x150Logo.png"
        Square44x44Logo="Packaging\Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Packaging\Images\Wide310x150Logo.png"
          Square71x71Logo="Packaging\Images\SmallTile.png"
          Square310x310Logo="Packaging\Images\LargeTile.png" />
        <uap:SplashScreen Image="Packaging\Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Backs Settings > "Start Forecast Center with Windows". TaskId must match AppIdentity.StartupTaskId. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="ForecastCenterStartup" Enabled="false" DisplayName="Forecast Center" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Used only when the user chooses "Automatic location". -->
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
